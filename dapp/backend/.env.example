# ---------- required ----------
# PostgreSQL. Local: `npm run db:up` (Docker) -> the value below. Cloud: paste your Neon/Supabase URL.
DATABASE_URL="postgresql://voting:voting@localhost:5432/voting"
# Alchemy Sepolia HTTPS URL (dashboard -> your app -> Endpoints)
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# ---------- Alchemy webhook (recommended) ----------
# Dashboard -> Webhooks -> your Custom Webhook -> "Signing key" (top right). Leave empty to disable the webhook endpoint.
ALCHEMY_WEBHOOK_SIGNING_KEY=""
# Optional: reject deliveries from any other webhook id (wh_...)
ALCHEMY_WEBHOOK_ID=""

# ---------- optional ----------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS="http://localhost:5173"
# Reconciler: blocks to wait before an event is final (reorg safety), polling interval, eth_getLogs range per request.
# Alchemy FREE plan allows only 10 blocks per eth_getLogs request -> keep LOG_CHUNK_BLOCKS=10 unless you're on a paid plan.
CONFIRMATIONS=6
RECONCILE_INTERVAL_SECONDS=15
LOG_CHUNK_BLOCKS=10
MAX_BLOCKS_PER_TICK=500
