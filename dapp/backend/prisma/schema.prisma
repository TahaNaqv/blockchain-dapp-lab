// PostgreSQL schema for the Voting DApp backend.
//
// Design: event-sourced.
//   ChainEvent  = every decoded contract log (idempotent key: txHash:logIndex), from the Alchemy webhook (unconfirmed)
//                 or the reconciler (confirmed after N blocks).
//   Election / Vote / Voter = read-models PROJECTED from ChainEvents. Each row references the event that created it with
//                 onDelete: Cascade, so if a chain reorg removes an event, everything derived from it disappears too.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventSource {
  WEBHOOK
  RECONCILER
}

model ChainEvent {
  id             String      @id // `${txHash}:${logIndex}`
  eventName      String
  blockNumber    Int
  blockHash      String
  blockTimestamp DateTime
  txHash         String
  logIndex       Int
  args           Json
  source         EventSource
  confirmed      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  election          Election? @relation("ElectionCreatedEvent")
  cancelledElection Election? @relation("ElectionCancelledEvent")
  vote              Vote?
  voters            Voter[]

  @@index([blockNumber])
  @@index([confirmed, blockNumber])
}

model Election {
  id            Int      @id // on-chain electionId
  title         String
  options       String[]
  startTime     DateTime
  endTime       DateTime
  allowlistOnly Boolean
  creator       String

  createdEventId   String      @unique
  createdEvent     ChainEvent  @relation("ElectionCreatedEvent", fields: [createdEventId], references: [id], onDelete: Cascade)
  cancelledEventId String?     @unique
  cancelledEvent   ChainEvent? @relation("ElectionCancelledEvent", fields: [cancelledEventId], references: [id], onDelete: SetNull)

  votes  Vote[]
  voters Voter[]

  @@index([endTime])
}

model Vote {
  id          String     @id // = ChainEvent.id
  event       ChainEvent @relation(fields: [id], references: [id], onDelete: Cascade)
  electionId  Int
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter       String // lower-case address
  option      Int
  blockNumber Int
  txHash      String
  castAt      DateTime

  @@unique([electionId, voter])
  @@index([voter])
  @@index([electionId, option])
}

model Voter {
  electionId Int
  election   Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  address    String // lower-case
  eventId    String
  event      ChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([electionId, address])
}

model WebhookDelivery {
  id         String   @id // Alchemy event id (whevt_...)
  webhookId  String
  logCount   Int
  receivedAt DateTime @default(now())
}

model SyncState {
  id                 Int      @id @default(1)
  lastConfirmedBlock Int
  updatedAt          DateTime @updatedAt
}
